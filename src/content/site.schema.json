{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ogImage": {
          "type": "string",
          "description": "1200×630 JPEG used for link previews (WhatsApp, LinkedIn…); keep it under 300 KB and rename it when it changes, platforms cache by URL"
        },
        "ogImageAlt": {
          "description": "Describes the link-preview image for screen readers",
          "type": "string"
        },
        "googleSiteVerification": {
          "description": "Google Search Console \"HTML tag\" verification code (only the content value)",
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "description",
        "url",
        "ogImage"
      ]
    },
    "theme": {
      "type": "object",
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Page background"
        },
        "card": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Plain card background"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Text, borders and hard shadows"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Primary brand colour (name highlight, main buttons)"
        },
        "blue": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "orange": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "lime": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "yellow": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sky": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "bg",
        "card",
        "ink",
        "accent",
        "blue",
        "orange",
        "lime",
        "yellow",
        "sky",
        "mint"
      ],
      "description": "Every key becomes a CSS variable (--bg, --accent, …); cards cycle through the pop colours"
    },
    "analytics": {
      "description": "Remove to turn tracking off. Only added to production builds, never the dev server",
      "type": "object",
      "properties": {
        "gtmId": {
          "description": "Google Tag Manager container ID. When set, only GTM loads and GA4 is configured inside GTM (see analytics/README.md)",
          "type": "string",
          "pattern": "^GTM-[A-Z0-9]+$"
        },
        "googleId": {
          "description": "Google Analytics 4 Measurement ID; loaded directly (gtag.js) when there is no gtmId",
          "type": "string",
          "pattern": "^G-[A-Z0-9]+$"
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "webgl": {
          "type": "boolean",
          "description": "false = no 3D avatar, the poster image is shown instead"
        }
      },
      "required": [
        "webgl"
      ]
    },
    "avatar": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "description": "GLB under src/assets, e.g. \"models/me.glb\" (built by `bun run models`)"
        },
        "poster": {
          "description": "Static image shown when 3D is off (no WebGL / reduced motion)",
          "type": "string"
        },
        "alt": {
          "type": "string",
          "description": "Accessible description of the figure"
        },
        "followPointer": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Max degrees the figure turns toward the cursor"
        },
        "handScale": {
          "description": "Enlarge the hands (both *Hand bones) so gestures read at small sizes; 1 = as modelled",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "clips": {
          "description": "Action names from src/shared/three/gestures.ts (idle, vanakkam, thumbs-up, wave, nod, shrug, point, cheer, think…), or clip names if the GLB ships its own",
          "type": "object",
          "properties": {
            "idle": {
              "type": "string"
            },
            "greet": {
              "description": "Played when the figure appears and on hover, e.g. \"vanakkam\"",
              "type": "string"
            },
            "cheer": {
              "description": "Played when the figure is clicked",
              "type": "string"
            }
          },
          "required": [
            "idle"
          ]
        }
      },
      "required": [
        "enabled",
        "model",
        "alt",
        "followPointer"
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "jobTitle": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "description": "Shown in the Contact section and on the CV; remove to hide everywhere",
          "type": "string",
          "pattern": "^\\+?[0-9][0-9 ()-]{6,19}$"
        },
        "roles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rotating lines under the name in the hero"
        },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "dev:<devicon-file> | si:<simple-icon>[/hex] | assets/relative/path | /public/path | https://url"
              }
            },
            "required": [
              "label",
              "href",
              "icon"
            ]
          }
        }
      },
      "required": [
        "firstName",
        "lastName",
        "jobTitle",
        "email",
        "roles",
        "socials"
      ]
    },
    "nav": {
      "type": "object",
      "properties": {
        "cta": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ]
        }
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "hero"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "primaryCta": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              },
              "secondaryCta": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              },
              "stickers": {
                "description": "Short tilted labels around the avatar, e.g. \"13+ yrs 🚀\"",
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "id",
              "primaryCta"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "marquee"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "hidden": {
                "type": "boolean"
              },
              "items": {
                "description": "Words scrolling across the strip; defaults to every skill name",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "about"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "paragraphs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "suffix": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "quote",
              "paragraphs",
              "stats"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "experience"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "finish": {
                "description": "Shown when the career road reaches today, e.g. \"13+ years and counting\"",
                "type": "string"
              },
              "pointsLabel": {
                "description": "Heading of the side card on the career road (the board shows role/company/period)",
                "type": "string"
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "company": {
                      "type": "string"
                    },
                    "period": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "points": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tech": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "art": {
                      "description": "Unused since the career road (kept so older content still validates)",
                      "type": "string"
                    },
                    "color": {
                      "description": "Card colour of this stop (text turns light/dark to match)",
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    }
                  },
                  "required": [
                    "role",
                    "company",
                    "period",
                    "points"
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "skills"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "groups": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "icon": {
                            "type": "string",
                            "description": "dev:<devicon-file> | si:<simple-icon>[/hex] | assets/relative/path | /public/path | https://url"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  },
                  "required": [
                    "label",
                    "items"
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "groups"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "projects"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "moreLink": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "tech": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "image": {
                      "description": "Card image (path under src/assets, e.g. \"projects/x.webp\")",
                      "type": "string"
                    },
                    "featured": {
                      "type": "boolean"
                    },
                    "label": {
                      "description": "Small tag, e.g. \"Open Source\" or \"Client · Private\"",
                      "type": "string"
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "demo": {
                          "type": "string",
                          "format": "uri"
                        },
                        "source": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  },
                  "required": [
                    "name",
                    "description",
                    "tech"
                  ]
                }
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "contact"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Anchor id, used in the URL hash (#id)"
              },
              "navLabel": {
                "description": "Shown in the navbar when set",
                "type": "string"
              },
              "hidden": {
                "description": "Set true to remove the section without deleting its content",
                "type": "boolean"
              },
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "cta": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              }
            },
            "required": [
              "type",
              "id",
              "title",
              "text"
            ]
          }
        ]
      },
      "description": "Rendered top to bottom in this order"
    },
    "footer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "cv": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Print-safe accent for dates and the job title on white paper (needs 4.5:1 on white)"
        },
        "summary": {
          "description": "Defaults to the first About paragraph",
          "type": "string"
        },
        "projectLimit": {
          "description": "Max projects listed (default: all)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "accent"
      ],
      "description": "Printable CV page at /cv/ — built from the same content as the site"
    }
  },
  "required": [
    "meta",
    "theme",
    "effects",
    "person",
    "nav",
    "sections",
    "footer",
    "cv"
  ]
}
